# Copy to .env for local use. Never commit .env.

# --- ServiceNow (same variables as oricohen392/mcp-snow) ---
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_AUTH_TYPE=basic            # basic | oauth | api_key

# basic (and oauth password grant)
SERVICENOW_USERNAME=itom.mcp.integration
SERVICENOW_PASSWORD=change-me
# or: SERVICENOW_PASSWORD_FILE=/path/to/file

# oauth
#SERVICENOW_CLIENT_ID=
#SERVICENOW_CLIENT_SECRET=
#SERVICENOW_TOKEN_URL=https://your-instance.service-now.com/oauth_token.do

# api_key
#SERVICENOW_API_KEY=
#SERVICENOW_API_KEY_HEADER=X-ServiceNow-API-Key

# Custom instance domain? add it explicitly (default: service-now.com,servicenowservices.com)
#SERVICENOW_ALLOWED_HOSTS=service-now.com
#CA_BUNDLE=/etc/pki/custom/ca.pem
SERVICENOW_TIMEOUT=30

# --- Safety ---
READ_ONLY=true
MAX_LIMIT=200
DEFAULT_LIMIT=25
RATE_LIMIT_PER_MINUTE=120
MAX_TRAVERSAL_DEPTH=3
MAX_TRAVERSAL_NODES=300
ENABLE_GENERIC_QUERY=true
LOG_LEVEL=INFO

# --- HTTP transport (only for --transport http) ---
#MCP_AUTH_TOKEN=            # openssl rand -hex 32
#MCP_HTTP_HOST=127.0.0.1
#MCP_HTTP_PORT=8080
#MCP_ALLOWED_HOSTS=itom-mcp.apps.cluster.example.com
#MCP_AUTH_TOKENS_FILE=/path/to/tokens.txt   # lines: <client-name>:<token>  (preferred over MCP_AUTH_TOKEN)
#AUTH_MAX_FAILURES_PER_MINUTE=10
#FORWARDED_ALLOW_IPS=127.0.0.1

# --- Abuse limits / writes ---
#MAX_RESPONSE_CHARS=200000
#MAX_CONCURRENCY=8
#WRITE_APPROVAL=elicit            # elicit (human approves in client) | confirm_flag (weaker)
#WRITE_RATE_LIMIT_PER_MINUTE=5
